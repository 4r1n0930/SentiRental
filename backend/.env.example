NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://senti:senti@localhost:5432/senti_rental
DIRECT_URL=postgresql://senti:senti@localhost:5432/senti_rental

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=senti-rental-api
JWT_AUDIENCE=senti-rental-mobile
REFRESH_TOKEN_TTL_DAYS=30
TOKEN_PEPPER=replace-with-a-different-32-character-secret

GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match this exact value in Google Cloud Console. For the Expo app set it
# to the app scheme (sentirental://auth/google/callback) so the in-app browser
# can capture the redirect -- there is no GET /auth/google/callback route yet.
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

MAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@senti-rental.local

SWAGGER_ENABLED=true
TRUST_PROXY=false
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Returns raw verification and reset tokens in API responses so the mobile app
# can exercise those flows without a mail server. Setting this while
# NODE_ENV=production makes the API refuse to boot.
DEV_EXPOSE_TOKENS=false

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
ARGON2_OUTPUT_LENGTH=32
